#!/usr/bin/env zsh
set -euo pipefail

CONFIG="$HOME/.workstreams"

if [[ ! -f "$CONFIG" ]]; then
    echo "No workstreams configured ($CONFIG not found)."
    exit 0
fi

printf "%-25s %-30s %-15s %-7s %s\n" "NAME" "DIRECTORY" "FLAGS" "STATUS" "BRANCH"
printf "%-25s %-30s %-15s %-7s %s\n" "----" "---------" "-----" "------" "------"

while IFS=: read -r name dir flags branch rest; do
    [[ "$name" =~ ^#.*$ || -z "$name" ]] && continue
    if tmux has-session -t "=${name}" 2>/dev/null; then
        sess_status="alive"
    else
        sess_status="dead"
    fi
    # Only show branch if it differs from session name
    if [[ -n "$branch" && "$branch" != "$name" ]]; then
        show_branch="$branch"
    else
        show_branch=""
    fi
    printf "%-25s %-30s %-15s %-7s %s\n" "$name" "$dir" "${flags:--}" "$sess_status" "$show_branch"
done < "$CONFIG"
