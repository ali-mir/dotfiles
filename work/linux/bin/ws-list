#!/usr/bin/env zsh
set -euo pipefail

CONFIG="$HOME/.workstreams"

if [[ ! -f "$CONFIG" ]]; then
    echo "No workstreams configured ($CONFIG not found)."
    exit 0
fi

printf "%-25s %-30s %-15s %s\n" "NAME" "DIRECTORY" "FLAGS" "STATUS"
printf "%-25s %-30s %-15s %s\n" "----" "---------" "-----" "------"

while IFS=: read -r name dir flags; do
    [[ "$name" =~ ^#.*$ || -z "$name" ]] && continue
    if tmux has-session -t "=${name}" 2>/dev/null; then
        sess_status="alive"
    else
        sess_status="dead"
    fi
    printf "%-25s %-30s %-15s %s\n" "$name" "$dir" "${flags:--}" "$sess_status"
done < "$CONFIG"
