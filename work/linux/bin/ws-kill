#!/usr/bin/env zsh
set -euo pipefail

MAIN_REPO="$HOME/mongo"
CONFIG="$HOME/.workstreams"
BAZEL_CACHE="$HOME/.cache/bazel/_bazel_$(whoami)"

usage() {
    cat <<'EOF'
Usage: ws-kill <name>

Remove a workstream. Kills the tmux session and removes the config entry.

For mongo worktrees, also:
  - Removes compile_commands.json
  - Removes the git worktree
  - Deletes the branch
  - Cleans up associated bazel cache directories

For --dir workstreams on a git repo, also:
  - Checks out the repo's default branch (master/main)
  - Deletes the working branch
  (skipped if the working tree is dirty)
EOF
    exit 1
}

[[ $# -ne 1 || "$1" == "-h" || "$1" == "--help" ]] && usage
name="$1"

# Sanitize dots (same as ws-new)
if [[ "$name" == *"."* ]]; then
    name="${name//./-}"
fi

# Read config entry
config_line=$(grep "^${name}:" "$CONFIG" 2>/dev/null || true)
if [[ -z "$config_line" ]]; then
    echo "Error: workstream '$name' not found in $CONFIG"
    exit 1
fi

dir=$(echo "$config_line" | cut -d: -f2)
flags=$(echo "$config_line" | cut -d: -f3)
config_branch=$(echo "$config_line" | cut -d: -f4)
dir="${dir/#\~/$HOME}"

# Detect live branch from worktree directory, fall back to config then session name
branch=""
if [[ -d "$dir" ]]; then
    branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
fi
[[ -z "$branch" ]] && branch="${config_branch:-$name}"

echo "=== Killing workstream: $name ==="

# Build list of actions
actions=()

if tmux has-session -t "=${name}" 2>/dev/null; then
    actions+=("Kill tmux session '$name'")
fi

is_worktree=false
is_dir_repo=false
dir_default_branch=""
if [[ "$flags" == *worktree* ]]; then
    is_worktree=true

    if [[ -f "$dir/compile_commands.json" ]]; then
        actions+=("Remove $dir/compile_commands.json")
    fi

    if git -C "$MAIN_REPO" worktree list --porcelain | grep -q "^worktree ${dir}$"; then
        actions+=("Remove git worktree at $dir")
    fi

    # Check if branch exists
    if git -C "$MAIN_REPO" rev-parse --verify "$branch" &>/dev/null; then
        actions+=("Delete branch '$branch'")
    fi

    # Find bazel cache dirs
    bazel_dirs=()
    if [[ -d "$BAZEL_CACHE" ]]; then
        for marker in "$BAZEL_CACHE"/*/DO_NOT_BUILD_HERE; do
            [[ -f "$marker" ]] || continue
            if [[ "$(cat "$marker")" == "$dir" ]]; then
                bdir="$(dirname "$marker")"
                size=$(du -sh "$bdir" 2>/dev/null | cut -f1)
                bazel_dirs+=("$bdir")
                actions+=("Remove bazel cache $(basename "$bdir") ($size)")
            fi
        done
    fi
elif [[ -d "$dir" ]] && git -C "$dir" rev-parse --git-dir &>/dev/null; then
    # --dir mode on a git repo: offer to restore default branch and delete working branch
    is_dir_repo=true
    # Determine default branch: origin/HEAD → master → main
    dir_default_branch=$(git -C "$dir" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || true)
    if [[ -z "$dir_default_branch" ]]; then
        git -C "$dir" rev-parse --verify master &>/dev/null && dir_default_branch=master
    fi
    if [[ -z "$dir_default_branch" ]]; then
        git -C "$dir" rev-parse --verify main &>/dev/null && dir_default_branch=main
    fi

    if [[ -n "$dir_default_branch" && -n "$branch" && "$branch" != "$dir_default_branch" ]]; then
        if [[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]]; then
            actions+=("Skip branch cleanup in $dir (uncommitted changes on '$branch')")
        else
            actions+=("Checkout '$dir_default_branch' in $dir")
            actions+=("Delete branch '$branch' in $dir")
        fi
    fi
fi

actions+=("Remove config entry from $CONFIG")

if [[ ${#actions[@]} -eq 0 ]]; then
    echo "  Nothing to clean up."
    exit 0
fi

echo "  Will execute:"
for a in "${actions[@]}"; do
    echo "    - $a"
done

echo ""
read "confirm?  Proceed? [y/N] "
[[ "$confirm" =~ ^[Yy]$ ]] || { echo "  Aborted."; exit 0; }

# Execute — session kill is last so that running ws-kill from within
# the session being killed doesn't abort cleanup mid-flight.

if [[ "$is_worktree" == true ]]; then
    if [[ -f "$dir/compile_commands.json" ]]; then
        rm -f "$dir/compile_commands.json"
        echo "  Removed compile_commands.json."
    fi

    if git -C "$MAIN_REPO" worktree list --porcelain | grep -q "^worktree ${dir}$"; then
        git -C "$MAIN_REPO" worktree remove "$dir"
        echo "  Removed worktree."
    fi

    if git -C "$MAIN_REPO" rev-parse --verify "$branch" &>/dev/null; then
        git -C "$MAIN_REPO" branch -D "$branch"
        echo "  Deleted branch."
    fi

    if [[ ${#bazel_dirs[@]} -gt 0 ]]; then
        for d in "${bazel_dirs[@]}"; do
            chmod -R u+w "$d" 2>/dev/null || true
            rm -rf "$d"
            echo "  Removed bazel cache: $(basename "$d")"
        done
    fi
fi

if [[ "$is_dir_repo" == true && -n "$dir_default_branch" && -n "$branch" && "$branch" != "$dir_default_branch" ]]; then
    if [[ -z "$(git -C "$dir" status --porcelain 2>/dev/null)" ]]; then
        git -C "$dir" checkout "$dir_default_branch"
        echo "  Checked out $dir_default_branch in $dir."
        if git -C "$dir" rev-parse --verify "$branch" &>/dev/null; then
            git -C "$dir" branch -D "$branch"
            echo "  Deleted branch '$branch' in $dir."
        fi
    fi
fi

# Remove config entry
grep -v "^${name}:" "$CONFIG" > "${CONFIG}.tmp" && mv "${CONFIG}.tmp" "$CONFIG"
echo "  Removed config entry."

# Kill tmux session last — if we're inside the session being killed, this
# terminates the pane running this script, so everything above must finish first.
if tmux has-session -t "=${name}" 2>/dev/null; then
    if [[ -n "${TMUX:-}" ]]; then
        current_session=$(tmux display-message -p '#S')
        if [[ "$current_session" == "$name" ]]; then
            sessions=("${(@f)$(tmux list-sessions -F '#S')}")
            prev=""
            for s in "${sessions[@]}"; do
                [[ "$s" == "$name" ]] && break
                prev="$s"
            done
            [[ -z "$prev" ]] && prev=$(tmux list-sessions -F '#S' | grep -v "^${name}$" | tail -1)
            if [[ -n "$prev" ]]; then
                tmux switch-client -t "=${prev}"
            fi
        fi
    fi
    tmux kill-session -t "=${name}"
    echo "  Killed tmux session."
fi

echo "  Done."
