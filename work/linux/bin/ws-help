#!/usr/bin/env zsh

cat <<'EOF'
Workstream commands — manage tmux sessions + git worktrees for mongo development.

━━━ ws-new ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  ws-new <name> [options]

  Default mode: creates a git worktree at ~/<name>, a branch named <name>
  off master, a venv at ~/<name>/venv synced from the worktree's uv.lock,
  and a tmux session with a zsh window (venv activated) and a claude window.

  Options:
    --base <ref>       Branch or tag to base the worktree on. Default: master.
                       Use git tags (e.g. r4.4.9) for old releases.
    --branch <name>    Use a different git branch name from the session name.
    --dir <path>       Skip worktree creation; point the session at an existing
                       directory instead. Good for non-mongo repos.

  Examples:
    ws-new my-feature
      → branch: my-feature, base: master, dir: ~/my-feature

    ws-new my-feature --base v8.1
      → branch: my-feature, base: v8.1 (e.g. for a backport)

    ws-new SERVER-12345 --branch fix/my-thing
      → session: SERVER-12345, branch: fix/my-thing

    ws-new help-93592 --base r4.4.9
      → throwaway branch at 4.4.9 tag, cleaned up by ws-kill

    ws-new dotfiles --dir ~/dotfiles
      → session pointing at existing dir, no worktree

━━━ ws-kill ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  ws-kill <name>

  Removes a workstream. Always asks for confirmation before doing anything.

  For mongo worktrees, also:
    - Removes the git worktree directory
    - Deletes the git branch
    - Removes associated bazel cache directories
    - Removes compile_commands.json if present
    - Removes the worktree's venv

  For --dir sessions on a git repo (non-worktree), also:
    - Checks out the repo's default branch
    - Deletes the working branch
    (skipped if the working tree is dirty)

  Always: removes the config entry from ~/.workstreams and kills the tmux session.
  Safe to run from inside the session being killed.

━━━ ws-list ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  ws-list

  Prints all workstreams from ~/.workstreams with their directory, flags,
  tmux session status (alive/dead), and branch (if different from session name).

━━━ Config file ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  ~/.workstreams — one entry per line:
    <name>:<dir>:<flags>:<branch>

  flags: comma-separated, e.g. "venv,worktree"
    worktree  — managed git worktree (ws-kill will remove it)
    venv      — venv is activated on session start

EOF
