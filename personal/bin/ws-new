#!/usr/bin/env zsh
set -euo pipefail

DEV_DIR="$HOME/dev"
CONFIG="$HOME/.workstreams"

usage() {
    cat <<'EOF'
Usage: ws-new <name> [--dir <path>]

Create a new workstream (tmux session).

Without --dir, creates a session at ~/dev/<name> (directory created if needed).
With --dir, uses the given path instead (also created if needed).
EOF
    exit 1
}

name=""
dir=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dir)
            [[ $# -lt 2 ]] && usage
            dir="$2"; shift 2 ;;
        -h|--help)
            usage ;;
        -*)
            echo "Unknown option: $1"; usage ;;
        *)
            [[ -n "$name" ]] && { echo "Too many arguments"; usage; }
            name="$1"; shift ;;
    esac
done

[[ -z "$name" ]] && usage

# Default directory is ~/dev/<name> (use original name before sanitization)
if [[ -z "$dir" ]]; then
    dir="$DEV_DIR/$name"
fi

# Sanitize name: tmux silently replaces dots with underscores, which breaks
# subsequent target lookups. Replace dots with hyphens upfront.
if [[ "$name" == *"."* ]]; then
    sanitized="${name//./-}"
    echo "Note: tmux doesn't allow dots in session names. Using '$sanitized' instead."
    name="$sanitized"
fi

# Expand ~ and resolve
dir="${dir/#\~/$HOME}"

# Create directory if it doesn't exist
if [[ ! -d "$dir" ]]; then
    echo "Creating directory $dir..."
    mkdir -p "$dir"
fi

dir="$(cd "$dir" && pwd)"

# Ensure config file exists
touch "$CONFIG"

# Check if workstream already exists in config
if grep -q "^${name}:" "$CONFIG" 2>/dev/null; then
    echo "Error: workstream '$name' already exists in $CONFIG"
    exit 1
fi

# Check if tmux session already exists
if tmux has-session -t "=${name}" 2>/dev/null; then
    echo "Error: tmux session '$name' already exists"
    exit 1
fi

echo "Creating tmux session '$name' at $dir..."
tmux new-session -d -s "$name" -c "$dir"

# Store with ~ for portability
config_dir="${dir/#$HOME/~}"
echo "${name}:${config_dir}" >> "$CONFIG"
echo "Done. Workstream '$name' created (directory: $dir)."

if [[ -n "${TMUX:-}" ]]; then
    echo "Switch with: tmux switch-client -t $name"
    echo "Or press Ctrl-a s to pick from session list."
else
    echo "Attach with: tmux attach -t $name"
fi
