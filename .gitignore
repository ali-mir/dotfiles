# Arc plaintext exports — only .age encrypted versions should be committed
common/arc/*.json
common/arc/*.plist
.DS_Store

# secrets — tokens and credentials, never commit
work/secrets.sh

# workstreams changes frequently per-machine — only the .default template is tracked
work/linux/.workstreams
personal/.workstreams

# Claude Desktop rewrites this in place (UI state + account ids) — not worth tracking
claude_desktop_config.json
